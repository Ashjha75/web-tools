# Main Portfolio App Configuration
VITE_APPWRITE_ENDPOINT=http://localhost/v1
VITE_APPWRITE_PROJECT_ID=web-tools
VITE_APPWRITE_DATABASE_ID=projects
VITE_APPWRITE_COLLECTION_ID=projects-list

# myDrive Project Configuration
# You need to create a Storage Bucket in your Appwrite project
# Go to: Appwrite Console > Storage > Create Bucket
# Copy the Bucket ID and paste it below
VITE_MYDRIVE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_MYDRIVE_APPWRITE_PROJECT_ID=your_project_id_here
VITE_MYDRIVE_BUCKET_ID=your_bucket_id_here